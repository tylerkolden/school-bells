# Copy to bell.env, set a strong shared password, and chmod 0600.
BELL_UI_PASSWORD=replace-with-a-long-random-password
# Set a persistent random value so login sessions survive service restarts.
BELL_UI_SESSION_SECRET=replace-with-a-different-long-random-value
# Optional automation API keys. The emergency key may override allowed hours.
BELL_API_KEY=replace-with-another-random-value
BELL_EMERGENCY_API_KEY=replace-with-a-separate-random-value
# Optional protocol adapter secrets referenced by destinations.yaml.
# BELL_SIP_PASSWORD=replace-me
# BELL_WEBHOOK_SECRET=replace-me
# Optional but strongly recommended for protecting UI/API credentials on the LAN.
# BELL_TLS_CERTFILE=/opt/bell/config/tls/fullchain.pem
# BELL_TLS_KEYFILE=/opt/bell/config/tls/privkey.pem
