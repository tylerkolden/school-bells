[Unit]
Description=School Bell Multicast Scheduler
After=network-online.target chrony.service
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=bell
WorkingDirectory=/opt/bell
ExecStartPre=/opt/bell/.venv/bin/python -m bell.service --check-only --config-dir /opt/bell/config
ExecStart=/opt/bell/.venv/bin/python -m bell.service --config-dir /opt/bell/config
Restart=on-failure
RestartSec=10
WatchdogSec=60
TimeoutStartSec=180
TimeoutStopSec=30
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/opt/bell/state /opt/bell/logs /opt/bell/config
NoNewPrivileges=yes
UMask=0077
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
EnvironmentFile=-/opt/bell/config/bell.env

[Install]
WantedBy=multi-user.target
